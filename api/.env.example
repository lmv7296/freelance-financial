# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# SECURITY NOTICE:
# - NEVER commit sensitive credentials or actual production secrets to git.
# - Copy this file to .env for local development: `cp .env.example .env`
# - The .env file is already excluded in .gitignore.
# =============================================================================

# Server Settings
APP_ENV=development
PORT=8080
HOST=127.0.0.1

# Server Timeouts (in seconds) - Slowloris DoS Defense
SERVER_READ_HEADER_TIMEOUT_SEC=5
SERVER_READ_TIMEOUT_SEC=10
SERVER_WRITE_TIMEOUT_SEC=30
SERVER_IDLE_TIMEOUT_SEC=120
SERVER_SHUTDOWN_TIMEOUT_SEC=10

# Security & CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Reverse proxies whose X-Forwarded-For header is trusted (IPs or CIDRs).
# Leave empty in development. In production, put Caddy/nginx in front of Next.js
# and have it SET (not append) X-Forwarded-For to the visitor's IP, then list the
# address Next.js connects to this API from, e.g. 127.0.0.1,::1. Never set this
# when Next.js is exposed directly: it forwards whatever header the browser sends.
TRUSTED_PROXIES=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50

# -----------------------------------------------------------------------------
# Database Configuration (matches docker-compose.yml)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=freelancer_finance
DB_SSLMODE=disable

# Full connection string format (usable by standard Go drivers / ORMs):
DATABASE_URL=postgres://app_user:app_password@localhost:5432/freelancer_finance?sslmode=disable

# Adminer Web UI Port (mapped away from 8080 to prevent Go server port conflict)
ADMINER_PORT=8081
