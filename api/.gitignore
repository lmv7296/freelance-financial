# -----------------------------------------------------------------------------
# Security: Environment Variables & Secrets
# NEVER commit files containing credentials, tokens, or sensitive variables.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/
credentials.json

# -----------------------------------------------------------------------------
# User uploads: customer receipts and company logos (./uploads/receipts,
# ./uploads/logos). Personal financial data, never commit it.
# -----------------------------------------------------------------------------
uploads/

