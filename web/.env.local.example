# Where Next.js forwards /api/* to (the Go backend in ../api). Server-side only.
# Go runs on port 8085; port 8080 is Docker Adminer.
API_PROXY_TARGET=http://localhost:8085

# Leave empty so the browser goes through the /api proxy (same origin, no CORS).
# Only set it to make the browser call the backend directly.
NEXT_PUBLIC_API_BASE_URL=

# Support email shown on the Help & support page
NEXT_PUBLIC_SUPPORT_EMAIL=
